# WeGrow Invest API v4.0 — Environment Configuration Template
WEGROW_ENVIRONMENT=development
WEGROW_DATABASE_URL=sqlite:///./wegrow.db

# JWT Settings (replace with strong 64-char random secret in production)
WEGROW_JWT_SECRET=replace-with-strong-production-secret-minimum-32-chars
WEGROW_JWT_ACCESS_TTL_MINUTES=60
WEGROW_JWT_REFRESH_TTL_DAYS=30

# OTP Delivery (set WEGROW_OTP_DEV_ECHO=false in production)
WEGROW_OTP_TTL_SECONDS=300
WEGROW_OTP_DEV_ECHO=true

# Market Data Provider
WEGROW_MARKET_PROVIDER=yfinance
WEGROW_MARKET_LIVE_ENABLED=true
WEGROW_MARKET_CACHE_TTL_SECONDS=900

# Uzbekistan Payments — Payme & Click (set WEGROW_PAYMENT_SANDBOX=false in production)
WEGROW_PAYMENT_SANDBOX=true
WEGROW_PAYME_MERCHANT_ID=your_payme_merchant_id
WEGROW_PAYME_MERCHANT_KEY=your_payme_secret_key
WEGROW_CLICK_SERVICE_ID=10001
WEGROW_CLICK_MERCHANT_ID=20001
WEGROW_CLICK_SECRET_KEY=your_click_secret_key

# CORS (comma-separated origins in production)
WEGROW_ALLOWED_ORIGINS=*
